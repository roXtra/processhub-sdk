{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // Load central defaults before repository-specific rules so local overrides take precedence.
  "extends": [
    "local>roXtra/Internal.RenovateConfig",
    "local>roXtra/processhub-sdk//.github/renovate-package-rules",
    ":timezone(Europe/Amsterdam)"
  ],
  "ignorePresets": [":prHourlyLimit2"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 12-14 * * 4"]
  },
  "major": {
    "minimumReleaseAge": "3 days"
  },
  "rangeStrategy": "bump",
  "prCreation": "not-pending",
  "assignees": ["@AlexKay34", "@VFritsch", "@m-reischl"],
  "assigneesSampleSize": 1,
  "enabledManagers": ["github-actions", "npm"],
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 6,
  "prHourlyLimit": 6,
  "npmrcMerge": true
}
